# ==============================================================================
# Variables de Entorno para el proyecto demo-sw (NORTE Studio Streetwear)
# ==============================================================================
# Copia este archivo a ".env" en la raíz del proyecto para desarrollo local:
#   cp .env.example .env (o "copy .env.example .env" en Windows)
# ==============================================================================

# Entorno de ejecución: 'development' para depuración local o 'production' para despliegue
DJANGO_ENV=development

# Clave secreta criptográfica de Django.
# ¡IMPORTANTE! Cambia este valor por una cadena aleatoria y segura en producción.
SECRET_KEY=django-insecure-demo-sw-streetwear-chile-key-2026-very-secret

# Modo de depuración (True en desarrollo, SIEMPRE False en producción)
DEBUG=True

# Lista de hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de base de datos (por defecto SQLite para la demo local)
# Para PostgreSQL: DATABASE_URL=postgres://usuario:password@localhost:5432/demo_sw
DATABASE_URL=sqlite:///db.sqlite3

# Nombre de la marca mostrado en la tienda (independiente del nombre técnico 'demo-sw')
STORE_BRAND_NAME=NORTE Studio

# Correo de contacto y notificaciones mostrado en el footer y políticas
STORE_CONTACT_EMAIL=contacto@nortestudio.cl

# Teléfono o WhatsApp de atención al cliente
STORE_CONTACT_PHONE=+56 9 8765 4321

# Monto mínimo de compra en CLP para despacho gratuito a todo Chile
FREE_SHIPPING_THRESHOLD=70000

# Costo de envío estándar fijo en CLP para compras inferiores al mínimo
STANDARD_SHIPPING_COST=3990
